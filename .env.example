# Copy to .env and adjust. All values are optional.

# Port the hub listens on (overrides cities.json "port").
PORT=3141

# Max concurrent agent runs. Spawns beyond this wait in a queue (status
# 'queued') until a running agent finishes and frees a slot.
HUB_MAX_CONCURRENT=4

# Handoff/run summaries: a completed run gets a one-line blurb. By default a
# short haiku call generates it (falling back to a cheap extractive one-liner).
# Set to 0 to skip the haiku call and always use the extractive summary.
HUB_HAIKU_SUMMARY=1
